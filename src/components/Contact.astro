---
// Contact — email (JS-assembled mailto to reduce scraping), plus external
// profile links. No phone number on the public site (kept in the PDF only).
interface Link {
  label: string;
  url: string;
}
interface Props {
  email: string;
  links: Link[];
}
const { email, links } = Astro.props;

// Drop any link whose URL is still a TODO placeholder.
const publicLinks = links.filter((l) => !/^todo/i.test(l.url.trim()));
const [emailUser, emailDomain] = email.split('@');
---

<section class="preview" id="contact">
  <div class="sec-head">
    <span class="tag">05 / contact</span>
    <h2>Get in touch</h2>
  </div>
  <div class="contact-grid">
    <div class="contact-email" id="contact-email">
      <a id="email-link" href="#" data-user={emailUser} data-domain={emailDomain}>
        <span class="k">email</span> <span class="v">[ enable JavaScript ]</span>
      </a>
      <button class="copy-btn" id="copy-email" type="button" aria-label="Copy email address" hidden>
        <svg class="icon-copy" viewBox="0 0 24 24" aria-hidden="true"><rect x="8.5" y="8.5" width="11" height="11" rx="2.5" /><path d="M15.5 8.5V6.5a2 2 0 0 0-2-2h-7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2" /></svg>
        <svg class="icon-ok" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 12.5l4.2 4.2L18.5 8" /></svg>
      </button>
      <span class="copy-status" id="copy-status" role="status"></span>
    </div>
    {
      publicLinks.map((l) => (
        <a href={l.url} target="_blank" rel="noopener">
          <span class="k">{l.label.toLowerCase()}</span> <span class="v" aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
        </a>
      ))
    }
  </div>
</section>

<script is:inline>
  /* assemble the mailto only in the browser so the address isn't in the HTML source */
  (() => {
    const el = document.getElementById('email-link');
    if (!el) return;
    const user = el.getAttribute('data-user');
    const domain = el.getAttribute('data-domain');
    if (!user || !domain) return;
    const addr = user + '@' + domain;
    el.setAttribute('href', 'mailto:' + addr);
    const v = el.querySelector('.v');
    if (v) v.textContent = addr;

    /* copy button — interaction from Lucian UX/UI Prompt #008 · MIT License (c) 2026
       Seokwoooo · https://lucianlabs.dev/uxui-prompt/#008 */
    const wrap = document.getElementById('contact-email');
    const btn = document.getElementById('copy-email');
    const status = document.getElementById('copy-status');
    if (!wrap || !btn || !status || !navigator.clipboard) return;
    btn.hidden = false;
    let timer = 0;
    btn.addEventListener('click', async () => {
      clearTimeout(timer);
      try {
        await navigator.clipboard.writeText(addr);
        status.textContent = 'Copied';
        wrap.classList.add('is-copied');
      } catch {
        status.textContent = 'Could not copy. Use the email link.';
      }
      wrap.classList.add('has-status');
      timer = setTimeout(() => {
        wrap.classList.remove('is-copied', 'has-status');
        status.textContent = '';
      }, 1800);
    });
  })();
</script>
